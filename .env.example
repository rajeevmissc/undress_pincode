# MongoDB - the database name goes in the PATH (after .net/), not the query string
MONGO_URI=mongodb+srv://USER:PASS@your-cluster.mongodb.net/pincode-delivery?retryWrites=true&w=majority

# Server
PORT=3000

# Shopify - used by scripts/registerCarrierService.ts AND, at runtime, by
# src/services/shopifyAdmin.ts to cancel orders declined over WhatsApp.
# The token needs write_shipping+read_shipping (carrier service) AND
# write_orders+read_orders (WhatsApp cancel flow) - reinstall the custom app
# after adding the order scopes, see README.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a PUBLIC https URL that reaches this server's /shopify/rates endpoint
CARRIER_SERVICE_CALLBACK_URL=https://your-server.example.com/shopify/rates
# The custom app's Client Secret (Dev Dashboard > your app > API credentials) -
# used ONLY to verify the X-Shopify-Hmac-Sha256 header on incoming webhooks.
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret so only your admin tooling can call POST /admin/import
ADMIN_API_KEY=change-me-to-a-long-random-string

# UltraMsg (https://ultramsg.com) - WhatsApp order-confirmation messages.
# Instance ID and Token from your UltraMsg instance dashboard.
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=xxxxxxxxxxxxxxxxxxxx
