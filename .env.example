# MongoDB - the database name goes in the PATH (after .net/), not the query string
MONGO_URI=mongodb+srv://USER:PASS@your-cluster.mongodb.net/pincode-delivery?retryWrites=true&w=majority

# Server
PORT=3000

# Shopify (used only by scripts/registerCarrierService.ts)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a PUBLIC https URL that reaches this server's /shopify/rates endpoint
CARRIER_SERVICE_CALLBACK_URL=https://your-server.example.com/shopify/rates

# Shared secret so only your admin tooling can call POST /admin/import
ADMIN_API_KEY=change-me-to-a-long-random-string
