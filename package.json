{
  "name": "pincode-delivery-app",
  "version": "1.0.0",
  "description": "Custom Shopify Carrier Service - pincode-based delivery options (DTDC/Delhivery fallback, hidden from customer)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "import": "ts-node src/scripts/importXlsx.ts",
    "test-resolver": "ts-node src/scripts/testResolver.ts",
    "validate-data": "ts-node --transpile-only scripts/validateRealData.ts",
    "register-carrier-service": "ts-node src/scripts/registerCarrierService.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
